{
  "rules": {
    "devices": {
      ".read": true,
      "$device": {
        ".read": true,
        ".write": false,
        "latest": {
          ".read": true,
          ".write": "auth != null && (auth.token.email == 'heng.xiao.hour@gmail.com' || auth.token.email == 'esp32-counter@chenla.com')"
        },
        "commands": {
          ".read": "auth != null && (auth.token.email == 'heng.xiao.hour@gmail.com' || auth.token.email == 'esp32-counter@chenla.com')",
          "$cmd": {
            ".write": "auth != null && (auth.token.email == 'heng.xiao.hour@gmail.com' || auth.token.email == 'esp32-counter@chenla.com')"
          }
        },
        "ota": {
          ".read": "auth != null && (auth.token.email == 'heng.xiao.hour@gmail.com' || auth.token.email == 'esp32-counter@chenla.com')",
          ".write": "auth != null && (auth.token.email == 'heng.xiao.hour@gmail.com' || auth.token.email == 'esp32-counter@chenla.com')"
        },
        "firmware": {
          ".read": "auth != null && (auth.token.email == 'heng.xiao.hour@gmail.com' || auth.token.email == 'esp32-counter@chenla.com')",
          ".write": "auth != null && (auth.token.email == 'heng.xiao.hour@gmail.com' || auth.token.email == 'esp32-counter@chenla.com')"
        },
        "console": {
          ".read": "auth != null && (auth.token.email == 'heng.xiao.hour@gmail.com' || auth.token.email == 'esp32-counter@chenla.com')",
          "$out": {
            ".write": "auth != null && (auth.token.email == 'heng.xiao.hour@gmail.com' || auth.token.email == 'esp32-counter@chenla.com')"
          }
        },
        "viewers": {
          ".read": true,
          "$v": {
            ".write": true,
            ".validate": "newData.hasChildren(['ts'])"
          }
        }
      }
    }
  }
}