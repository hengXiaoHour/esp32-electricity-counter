{
  /* ESP32 Electricity Counter — Realtime Database Security Rules
     latest/   : device writes the live snapshot (via Firebase Auth service account),
                 anyone may read (public dashboard).
     commands/ : anyone may push commands (fire-and-forget queue). The device
                 reads, executes, and deletes them.
     ota/      : release metadata + signed firmware URL, written only by an
                 authenticated owner (the upload script / service account).
                 The device reads it and writes its progress under /ota/status. */
  "rules": {
    "latest": {
      ".read": true,
      ".write": "auth != null"
    },
    "commands": {
      ".read": true,
      ".write": true
    },
    "ota": {
      ".read": true,
      ".write": "auth != null"
    }
  }
}