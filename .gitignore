test_*.png
tests/
*.pyc
__pycache__/

# Build artifacts. NOTE: arduino-cli's default build dir IS ./build, so a plain
# `arduino-cli compile` recreates a 4 MB directory of binaries next to the
# sources. It is always stale-able and is NOT what gets flashed unless you copy
# it by hand - prefer an explicit --output-dir.
build/
*.bin
*.elf

# Local agent scratch
.workflow/*.md
.workflow/active.json

# Playwright MCP artifacts
.playwright-mcp/
